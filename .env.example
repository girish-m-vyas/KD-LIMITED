# Copy to .env and fill in. .env is ignored by git — never commit real credentials.

APP_NAME="KD Limited"
# production | local
APP_ENV=production
# Only takes effect when APP_ENV=local. Never enable on a live site.
APP_DEBUG=false
APP_TIMEZONE=Asia/Kolkata
# Set if the site lives in a sub-folder, e.g. /kd-limited
APP_BASE_PATH=
# Set true when HTTPS is terminated by a proxy/load balancer in front of PHP
APP_FORCE_HTTPS=false
# Comma-separated proxy IPs whose X-Forwarded-For header may be trusted
TRUSTED_PROXIES=

# Database: mysql (production) or sqlite (quick local demo, no server needed)
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=kd
# A dedicated, least-privilege user. The app refuses to connect as root.
DB_USER=kd_app
DB_PASS=change-me-to-a-long-random-password
# Only for DB_DRIVER=sqlite (defaults to storage/database.sqlite)
DB_PATH=

# Session timeouts in seconds
ADMIN_IDLE_TIMEOUT=1800
SESSION_IDLE_TIMEOUT=7200
SESSION_ABSOLUTE_TIMEOUT=43200
