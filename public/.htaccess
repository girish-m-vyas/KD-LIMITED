# Apache: send every request that isn't a real file to index.php
Options -Indexes -MultiViews

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Only index.php may run as PHP inside public/.
<FilesMatch "\.(php|phtml|phar)$">
    Require all denied
</FilesMatch>
<Files "index.php">
    Require all granted
</Files>
